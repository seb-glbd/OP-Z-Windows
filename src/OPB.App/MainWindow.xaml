<Window x:Class="OPB.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OP-B" Width="1280" Height="720" MinWidth="480" MinHeight="300"
        Background="#D0D0D0" UseLayoutRounding="True">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition x:Name="StatusRow" Height="70" />
        </Grid.RowDefinitions>
        <ContentControl x:Name="ScreenHost" Grid.Row="0" Focusable="False" />
        <ContentControl x:Name="OverlayHost" Grid.Row="0" Focusable="False" />
        <ContentControl x:Name="StatusHost" Grid.Row="1" Focusable="False" />
        <ContentControl x:Name="StageHost" Grid.RowSpan="2" Focusable="False" />
    </Grid>
</Window>
